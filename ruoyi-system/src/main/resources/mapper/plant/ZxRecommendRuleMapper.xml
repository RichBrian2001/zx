<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.ZxRecommendRuleMapper">

    <resultMap type="ZxRecommendRule" id="ZxRecommendRuleResult">
        <id property="ruleId" column="rule_id" />
        <result property="ruleName" column="rule_name" />
        <result property="ruleCode" column="rule_code" />
        <result property="ruleType" column="rule_type" />
        <result property="triggerField" column="trigger_field" />
        <result property="triggerOperator" column="trigger_operator" />
        <result property="triggerValue" column="trigger_value" />
        <result property="actionType" column="action_type" />
        <result property="actionValue" column="action_value" />
        <result property="scoreValue" column="score_value" />
        <result property="priorityNum" column="priority_num" />
        <result property="status" column="status" />
        <result property="ruleDesc" column="rule_desc" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectZxRecommendRuleVo">
        select rule_id, rule_name, rule_code, rule_type, trigger_field, trigger_operator, trigger_value,
               action_type, action_value, score_value, priority_num, status, rule_desc,
               create_by, create_time, update_by, update_time, remark
        from zx_recommend_rule
    </sql>

    <select id="selectZxRecommendRuleById" parameterType="Long" resultMap="ZxRecommendRuleResult">
        <include refid="selectZxRecommendRuleVo" />
        where rule_id = #{ruleId}
    </select>

    <select id="selectZxRecommendRuleList" parameterType="ZxRecommendRule" resultMap="ZxRecommendRuleResult">
        <include refid="selectZxRecommendRuleVo" />
        where 1 = 1
        <if test="ruleName != null and ruleName != ''">
            and rule_name like concat('%', #{ruleName}, '%')
        </if>
        <if test="ruleCode != null and ruleCode != ''">
            and rule_code like concat('%', #{ruleCode}, '%')
        </if>
        <if test="ruleType != null and ruleType != ''">
            and rule_type = #{ruleType}
        </if>
        <if test="status != null and status != ''">
            and status = #{status}
        </if>
        order by priority_num, rule_id desc
    </select>

    <select id="checkRuleCodeUnique" parameterType="String" resultMap="ZxRecommendRuleResult">
        <include refid="selectZxRecommendRuleVo" />
        where rule_code = #{ruleCode}
        limit 1
    </select>

    <insert id="insertZxRecommendRule" parameterType="ZxRecommendRule" useGeneratedKeys="true" keyProperty="ruleId">
        insert into zx_recommend_rule
        <trim prefix="(" suffix=")" suffixOverrides=",">
            rule_name,
            rule_code,
            rule_type,
            <if test="triggerField != null">trigger_field,</if>
            <if test="triggerOperator != null">trigger_operator,</if>
            <if test="triggerValue != null">trigger_value,</if>
            <if test="actionType != null">action_type,</if>
            <if test="actionValue != null">action_value,</if>
            <if test="scoreValue != null">score_value,</if>
            priority_num,
            status,
            <if test="ruleDesc != null">rule_desc,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            #{ruleName},
            #{ruleCode},
            #{ruleType},
            <if test="triggerField != null">#{triggerField},</if>
            <if test="triggerOperator != null">#{triggerOperator},</if>
            <if test="triggerValue != null">#{triggerValue},</if>
            <if test="actionType != null">#{actionType},</if>
            <if test="actionValue != null">#{actionValue},</if>
            <if test="scoreValue != null">#{scoreValue},</if>
            #{priorityNum},
            #{status},
            <if test="ruleDesc != null">#{ruleDesc},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateZxRecommendRule" parameterType="ZxRecommendRule">
        update zx_recommend_rule
        <set>
            <if test="ruleName != null and ruleName != ''">rule_name = #{ruleName},</if>
            <if test="ruleCode != null and ruleCode != ''">rule_code = #{ruleCode},</if>
            <if test="ruleType != null and ruleType != ''">rule_type = #{ruleType},</if>
            <if test="triggerField != null">trigger_field = #{triggerField},</if>
            <if test="triggerOperator != null">trigger_operator = #{triggerOperator},</if>
            <if test="triggerValue != null">trigger_value = #{triggerValue},</if>
            <if test="actionType != null">action_type = #{actionType},</if>
            <if test="actionValue != null">action_value = #{actionValue},</if>
            <if test="scoreValue != null">score_value = #{scoreValue},</if>
            <if test="priorityNum != null">priority_num = #{priorityNum},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="ruleDesc != null">rule_desc = #{ruleDesc},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where rule_id = #{ruleId}
    </update>

    <update id="updateZxRecommendRuleStatus" parameterType="ZxRecommendRule">
        update zx_recommend_rule
        set status = #{status}, update_by = #{updateBy}, update_time = sysdate()
        where rule_id = #{ruleId}
    </update>

    <delete id="deleteZxRecommendRuleByIds" parameterType="Long">
        delete from zx_recommend_rule where rule_id in
        <foreach collection="array" item="ruleId" open="(" separator="," close=")">
            #{ruleId}
        </foreach>
    </delete>

</mapper>