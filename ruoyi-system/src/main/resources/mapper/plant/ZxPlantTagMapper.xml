<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.ZxPlantTagMapper">

    <resultMap type="ZxPlantTag" id="ZxPlantTagResult">
        <id property="tagId" column="tag_id" />
        <result property="tagName" column="tag_name" />
        <result property="tagCode" column="tag_code" />
        <result property="tagGroup" column="tag_group" />
        <result property="tagDesc" column="tag_desc" />
        <result property="sortNum" column="sort_num" />
        <result property="status" column="status" />
        <result property="delFlag" column="del_flag" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectZxPlantTagVo">
        select tag_id, tag_name, tag_code, tag_group, tag_desc, sort_num, status, del_flag,
               create_by, create_time, update_by, update_time, remark
        from zx_plant_tag
    </sql>

    <select id="selectZxPlantTagById" parameterType="Long" resultMap="ZxPlantTagResult">
        <include refid="selectZxPlantTagVo" />
        where tag_id = #{tagId}
    </select>

    <select id="selectZxPlantTagList" parameterType="ZxPlantTag" resultMap="ZxPlantTagResult">
        <include refid="selectZxPlantTagVo" />
        where del_flag = '0'
        <if test="tagName != null and tagName != ''">
            and tag_name like concat('%', #{tagName}, '%')
        </if>
        <if test="tagCode != null and tagCode != ''">
            and tag_code like concat('%', #{tagCode}, '%')
        </if>
        <if test="tagGroup != null and tagGroup != ''">
            and tag_group = #{tagGroup}
        </if>
        <if test="status != null and status != ''">
            and status = #{status}
        </if>
        order by sort_num, tag_id desc
    </select>

    <select id="checkTagCodeUnique" parameterType="String" resultMap="ZxPlantTagResult">
        <include refid="selectZxPlantTagVo" />
        where del_flag = '0' and tag_code = #{tagCode}
        limit 1
    </select>

    <insert id="insertZxPlantTag" parameterType="ZxPlantTag" useGeneratedKeys="true" keyProperty="tagId">
        insert into zx_plant_tag
        <trim prefix="(" suffix=")" suffixOverrides=",">
            tag_name,
            tag_code,
            tag_group,
            <if test="tagDesc != null">tag_desc,</if>
            sort_num,
            status,
            <if test="remark != null">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            #{tagName},
            #{tagCode},
            #{tagGroup},
            <if test="tagDesc != null">#{tagDesc},</if>
            #{sortNum},
            #{status},
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateZxPlantTag" parameterType="ZxPlantTag">
        update zx_plant_tag
        <set>
            <if test="tagName != null and tagName != ''">tag_name = #{tagName},</if>
            <if test="tagCode != null and tagCode != ''">tag_code = #{tagCode},</if>
            <if test="tagGroup != null and tagGroup != ''">tag_group = #{tagGroup},</if>
            <if test="tagDesc != null">tag_desc = #{tagDesc},</if>
            <if test="sortNum != null">sort_num = #{sortNum},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where tag_id = #{tagId}
    </update>

    <delete id="deleteZxPlantTagByIds" parameterType="Long">
        update zx_plant_tag set del_flag = '2' where tag_id in
        <foreach collection="array" item="tagId" open="(" separator="," close=")">
            #{tagId}
        </foreach>
    </delete>

</mapper>